# ---------------------------------------------------------------------------
# NEXUS ARCADE - environment
# Copy to .env and fill in. Every value here has a working default; with no
# .env at all the server boots in DEMO MODE (scripted mock LLM, fully playable).
# ---------------------------------------------------------------------------

# Which LLM backend to use: mock | azure | gemini | vertex | anthropic | openai
LLM_PROVIDER=azure

# Model id. Examples:
#   azure     -> gpt-4.1-mini            (Azure OpenAI - the deployed default)
#   gemini    -> gemini-2.5-flash        (Google AI Studio)
#   vertex    -> gemini-2.5-flash        (GCP Vertex AI)
#   anthropic -> claude-opus-5
#   openai    -> gpt-4o-mini / any OpenAI-compatible id
LLM_MODEL=gpt-4.1-mini

# --- Credentials (only the one matching LLM_PROVIDER is needed) -------------
# azure (Azure OpenAI). Paste the endpoint the portal shows on the resource -
# the app appends /openai/v1 itself. AZURE_OPENAI_DEPLOYMENT is the name you
# gave the deployment, which need not match the model id; left blank it falls
# back to LLM_MODEL.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# gemini (Google AI Studio, https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# vertex (GCP). Auth via Application Default Credentials:
#   local:      gcloud auth application-default login
#   Cloud Run:  nothing to do, the service account is used automatically
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global

# anthropic
ANTHROPIC_API_KEY=

# openai-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server ----------------------------------------------------------------
PORT=8080
# Secret used to sign anonymous player tokens. Generate one for production:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=dev-secret-change-me
DB_PATH=data/arcade.db

# --- Cost guardrails -------------------------------------------------------
# Max LLM calls a single player may make per rolling 24h (0 = unlimited)
DAILY_CALL_BUDGET=600
# Hard ceiling on output tokens per LLM call
MAX_OUTPUT_TOKENS=800
# Per-call timeout, seconds
LLM_TIMEOUT=45
