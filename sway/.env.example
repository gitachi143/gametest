# SWAY configuration. Copy to `.env` and fill in one provider.
# With no .env at all the app runs in DEMO MODE against a scripted opponent.

# --- pick one provider ------------------------------------------------------
# Azure OpenAI (what the deployed service uses). Paste the endpoint the portal
# shows on the resource; the app appends /openai/v1 itself. The deployment name
# need not match the model id - left unset it falls back to LLM_MODEL.
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Google AI Studio (easiest: https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# GCP Vertex AI (no API key - the service account or your ADC is the credential)
# LLM_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_LOCATION=global

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- model ------------------------------------------------------------------
# Defaults per provider: gpt-4.1-mini (azure) / gemini-2.5-flash / claude-opus-5
# LLM_MODEL=gpt-4.1-mini

# --- server -----------------------------------------------------------------
PORT=8080
# Player records are keyed to HMAC-signed tokens. Changing this logs everyone out.
# APP_SECRET=change-me
# DB_PATH=data/sway.db

# --- limits -----------------------------------------------------------------
# Simultaneous model calls. Azure OpenAI meters a real per-minute token quota
# and Vertex serves flash models from shared capacity - either way a burst earns
# a 429, and queueing is the fix. On Azure you can also raise the deployment's
# TPM; on Vertex no quota increase helps.
# LLM_CONCURRENCY=3
# LLM_TIMEOUT=45
# MAX_OUTPUT_TOKENS=700
# Per-player, per-day model call ceiling (0 disables).
# DAILY_CALL_BUDGET=900
# The judge should be near-deterministic.
# JUDGE_TEMPERATURE=0.15
# Set to "off" to keep Gemini 2.5 thinking on (slower, no better here).
# GEMINI_THINKING_BUDGET=0
